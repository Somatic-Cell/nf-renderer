+static __forceinline__ __device__ void scatter_planet(PRDSpectral& p,
+    const m3::RaySegment& ray,double distance_m) {
+    p.m1FailureStage=FailureStage::Planet;p.m1FailureContext={};
+    const auto& a=optixLaunchParams.rayleigh;
+    const auto exact=m3device::point_at_distance(ray,distance_m);
+    const Vec3 position={float(exact.x),float(exact.y),float(exact.z)};
+    const double nx=exact.x;
+    const double ny=a.planetRadius+(exact.y-a.groundY);
+    const double nz=exact.z;
+    const double length=sqrt(nx*nx+ny*ny+nz*nz);
+    const Vec3 ng=m1::normalize(Vec3{float(nx/length),float(ny/length),float(nz/length)});
+    if(!m1::finite(position)||!m1::bsdf_unit_direction(ng)){
+        fail(p,FailureReason::PlanetIntersection,{{float(distance_m),position.x,position.y,position.z,
+             ng.x,ng.y,ng.z}});return;
+    }
+    p.position=vector(position);p.instanceID=m1::no_index;
+    if(p.bounce==0) {
+        p.m1PrimaryNormal=vector(ng);p.m1PrimaryAlbedo=make_float3(a.groundAlbedo);
+    }
+    if(p.bounce>=optixLaunchParams.frame.maxBounce){p.continueTrace=0;return;}
+    // Spectrally neutral, opaque Lambertian ground, explicitly parameterized.
+    // It uses the surface NEE policy and can exchange light with the atmosphere.
+    SurfaceBsdf bsdf;bsdf.type=MATERIAL_TYPE_DIFFUSE;
+    bsdf.simple={m1::MaterialKind::Diffuse,a.groundAlbedo,1,1};
+    const Vec3 incoming=m1::normalize(vector(p.wi));
+    scatter_surface(p,position,ng,ng,ng,incoming,bsdf);
+}
+
+// A single existing OptiX traversal first resolves alpha coverage and obtains
+// the nearest accepted triangle. We then sample the medium only up to that
+// endpoint (or the opaque planet if nearer). No stochastic alpha is re-tested.
+// Returning true means this segment was consumed by a scatter/planet/failure.
+static __forceinline__ __device__ bool advance_medium(PRDSpectral& p,float t_max) {
+    if(!optixLaunchParams.rayleigh.enabled)return false;
+    p.m1FailureStage=FailureStage::Atmosphere;p.m1FailureContext={};
+    const auto r=m3device::ray(vector(p.position),vector(p.wi),t_max);
+    double beta=0;
+    if(!m3device::coefficient(p,beta))return true;
+    // PCG32 supplies a uniform 24-bit value k/2^24. Use the midpoint of its
+    // probability cell in double, so inverse CDF never receives exactly 0/1.
+    // This consumes one draw and does not clamp a sampled flight distance.
+    const float uniform=p.random();
+    const double xi=double(uniform)+0.5/16777216.0;
+    const auto sampled=m3::sample_free_flight(optixLaunchParams.rayleigh,r,beta,xi);
+    if(sampled.status!=m3::Status::Ok){
+        fail(p,FailureReason::AtmosphereInverse,{{float(sampled.status),uniform,float(sampled.distance_m),
+             float(-log1p(-xi)),float(sampled.tau),float(sampled.tau_residual),
+             float(sampled.estimated_tau_error),float(sampled.iterations),float(sampled.evaluations)}});
+        return true;
+    }
+    if(sampled.scattered) {
+        const auto exact=m3device::point_at_distance(r,sampled.distance_m);
+        const auto represented=m3::represent_medium_point(optixLaunchParams.rayleigh,exact);
+        if(represented.status!=m3::Status::Ok) {
+            fail(p,FailureReason::AtmospherePosition,{{float(represented.status),uniform,
+                 float(sampled.distance_m),float(exact.x),float(exact.y),float(exact.z),
+                 represented.position.x,represented.position.y,represented.position.z}});
+            return true;
+        }
+        scatter_medium(p,represented.position);
+        return true;
+    }
+    if(sampled.endpoint==m3::Endpoint::Ground) {
+        scatter_planet(p,r,sampled.distance_m);
+        return true;
+    }
+    // The probability of reaching this endpoint is already exp(-tau).
+    // Adding another T here (or in miss/emitter evaluation) would give T^2.
+    return false;
+}
