diff --git a/include/m3/position.hpp b/include/m3/position.hpp
new file mode 100644
index 0000000..0075a70
--- /dev/null
+++ b/include/m3/position.hpp
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "m1/math.hpp"
+#include "m3/atmosphere.hpp"
+#include <cfloat>
+
+namespace m3 {
+
+struct MediumPointResult {
+    m1::Vec3 position{};
+    Status status = Status::NonfiniteGeometry;
+    bool rounded_outward = false;
+};
+
+// OptiX positions are floats. A valid double-precision scattering point close
+// to the opaque planet can round inside it, particularly far from the local
+// scene origin. Preserve the spherical domain when choosing its float image.
+// This does not move a truly invalid point out of the planet.
+//
+// Usually nearest rounding is returned unchanged. Only if that image is inside
+// the ground, round the inward-rounded coordinates toward the planet's exterior
+// by one adjacent float step. Coordinates already rounded outward stay intact.
+// Thus each absolute planet-relative coordinate is at least its exact value,
+// which preserves the sphere's exterior. This is a representational displacement
+// of at most one float step per changed coordinate, with no metric epsilon.
+M1_HD inline MediumPointResult represent_medium_point(
+    const AtmosphereParameters& parameters, DVec3 exact) {
+    MediumPointResult result;
+    result.status = validate_parameters(parameters);
+    if (result.status != Status::Ok) return result;
+    if (!finite(exact)) {
+        result.status = Status::NonfiniteGeometry;
+        return result;
+    }
+    double exact_height = 0, radius = 0;
+    result.status = detail::height_at(parameters, exact, exact_height, radius);
+    if (result.status != Status::Ok) return result;
+    if (exact_height < 0) {
+        result.status = Status::InsideGround;
+        return result;
+    }
+    // Reject values outside the float representation before performing a
+    // narrowing conversion; the renderer cannot trace such a position.
+    if (fabs(exact.x) > double(FLT_MAX) || fabs(exact.y) > double(FLT_MAX) ||
+        fabs(exact.z) > double(FLT_MAX)) {
+        result.status = Status::NonfiniteGeometry;
+        return result;
+    }
+    result.position = {float(exact.x), float(exact.y), float(exact.z)};
+    double rounded_height = 0;
+    result.status = detail::height_at(parameters,
+        {result.position.x, result.position.y, result.position.z}, rounded_height, radius);
+    if (result.status != Status::Ok || rounded_height >= 0) return result;
+
+    const double relative_y = parameters.planetRadius + (exact.y - parameters.groundY);
+    const double outward[3] = {exact.x, relative_y, exact.z};
+    const double coordinate[3] = {exact.x, exact.y, exact.z};
+    float rounded[3] = {result.position.x, result.position.y, result.position.z};
+    for (unsigned axis = 0; axis < 3; ++axis) {
+        if (outward[axis] > 0 && double(rounded[axis]) < coordinate[axis]) {
+            rounded[axis] = nextafterf(rounded[axis], HUGE_VALF);
+            result.rounded_outward = true;
+        } else if (outward[axis] < 0 && double(rounded[axis]) > coordinate[axis]) {
+            rounded[axis] = nextafterf(rounded[axis], -HUGE_VALF);
+            result.rounded_outward = true;
+        }
+    }
+    result.position = {rounded[0], rounded[1], rounded[2]};
+    if (!m1::finite(result.position)) {
+        result.status = Status::NonfiniteGeometry;
+        return result;
+    }
+    result.status = detail::height_at(parameters,
+        {rounded[0], rounded[1], rounded[2]}, rounded_height, radius);
+    if (result.status == Status::Ok && rounded_height < 0)
+        result.status = Status::InsideGround;
+    return result;
+}
+
+} // namespace m3
diff --git a/include/m3/transport.hpp b/include/m3/transport.hpp
new file mode 100644
index 0000000..2799c41
--- /dev/null
+++ b/include/m3/transport.hpp
@@ -0,0 +1,135 @@
+#pragma once
+
+#include "m1/math.hpp"
+#include <cfloat>
+
+namespace m3 {
+
+inline constexpr double transport_pi = 3.141592653589793238462643383279502884;
+
+namespace transport_detail {
+M1_HD inline bool finite(double value) {
+    return value == value && fabs(value) <= DBL_MAX;
+}
+M1_HD inline double invalid() { return double(NAN); }
+} // namespace transport_detail
+
+// Scalar, unpolarized Rayleigh phase density per unit solid angle. The direct
+// cosine API requires its physical domain; invalid inputs remain observable.
+M1_HD inline double rayleigh_phase(double cosine) {
+    if (!transport_detail::finite(cosine) || cosine < -1.0 || cosine > 1.0)
+        return transport_detail::invalid();
+    return (3.0 / (16.0 * transport_pi)) * (1.0 + cosine * cosine);
+}
+M1_HD inline float rayleigh_phase(float cosine) {
+    return static_cast<float>(rayleigh_phase(double(cosine)));
+}
+
+// Marginal CDF in mu: azimuth has already been integrated over [0, 2*pi).
+M1_HD inline double rayleigh_mu_cdf(double cosine) {
+    if (!transport_detail::finite(cosine) || cosine < -1.0 || cosine > 1.0)
+        return transport_detail::invalid();
+    return 0.5 + cosine * (3.0 + cosine * cosine) / 8.0;
+}
+
+M1_HD inline double sample_rayleigh_mu(double u) {
+    if (!transport_detail::finite(u) || u < 0.0 || u > 1.0)
+        return transport_detail::invalid();
+    if (u == 0.0) return -1.0;
+    if (u == 1.0) return 1.0;
+    // mu^3 + 3*mu = 8*u - 4. This is the real, monotone inverse on [-1, 1].
+    return 2.0 * sinh(asinh(4.0 * u - 2.0) / 3.0);
+}
+
+// OptiX ray directions are floats and need not have exactly unit norm when
+// promoted to double. Normalize the dot product in double. For finite nonzero
+// vectors Cauchy-Schwarz guarantees [-1,1]; only roundoff can cross that range.
+// This is not an angular support tolerance, a PDF floor, or an invalid-ray fix.
+M1_HD inline double rayleigh_direction_cosine(m1::Vec3 a, m1::Vec3 b) {
+    if (!m1::finite(a) || !m1::finite(b)) return transport_detail::invalid();
+    const double ax = a.x, ay = a.y, az = a.z;
+    const double bx = b.x, by = b.y, bz = b.z;
+    const double a2 = ax * ax + ay * ay + az * az;
+    const double b2 = bx * bx + by * by + bz * bz;
+    if (!(a2 > 0.0) || !(b2 > 0.0)) return transport_detail::invalid();
+    const double cosine = (ax * bx + ay * by + az * bz) / (sqrt(a2) * sqrt(b2));
+    if (!transport_detail::finite(cosine)) return transport_detail::invalid();
+    if (cosine < -1.0) return -1.0;
+    if (cosine > 1.0) return 1.0;
+    return cosine;
+}
+
+M1_HD inline float rayleigh_phase_directions(m1::Vec3 a, m1::Vec3 b) {
+    return static_cast<float>(rayleigh_phase(rayleigh_direction_cosine(a, b)));
+}
+
+struct RayleighDirectionSample {
+    m1::Vec3 direction{};
+    float value = 0.0f;
+    float pdf = 0.0f;
+    bool valid = false;
+};
+
+// previous_ray_direction and the returned direction follow the camera path,
+// toward successive vertices. For scalar Rayleigh, reciprocity makes this
+// backward kernel equal to the forward phase density. Do not assume the same
+// convention for a future oriented, conditional neural scattering kernel.
+// value and the actual proposal pdf remain distinct fields for that reason.
+M1_HD inline RayleighDirectionSample sample_rayleigh(
+    m1::Vec3 previous_ray_direction, float u_mu, float u_phi) {
+    if (!m1::finite(previous_ray_direction) || !m1::finite(u_mu) || !m1::finite(u_phi) ||
+        u_mu < 0.0f || u_mu > 1.0f || u_phi < 0.0f || u_phi >= 1.0f)
+        return {};
+    const double dx = previous_ray_direction.x, dy = previous_ray_direction.y,
+                 dz = previous_ray_direction.z;
+    const double length_squared = dx * dx + dy * dy + dz * dz;
+    if (!(length_squared > 0.0)) return {};
+    const double inverse_length = 1.0 / sqrt(length_squared);
+    const m1::Vec3 axis{float(dx * inverse_length), float(dy * inverse_length),
+                        float(dz * inverse_length)};
+    const double cosine = sample_rayleigh_mu(double(u_mu));
+    if (!transport_detail::finite(cosine) || cosine < -1.0 || cosine > 1.0)
+        return {};
+    const double sine = sqrt((1.0 - cosine) * (1.0 + cosine));
+    const double azimuth = (2.0 * transport_pi) * double(u_phi);
+    const m1::Vec3 local{float(sine * cos(azimuth)), float(sine * sin(azimuth)),
+                         float(cosine)};
+    const auto frame = m1::make_frame(axis);
+    const auto direction = m1::normalize(frame.to_world(local));
+    const float density = rayleigh_phase_directions(previous_ray_direction, direction);
+    if (!m1::finite(direction) || !m1::finite(density) || !(density > 0.0f)) return {};
+    return {direction, density, density, true};
+}
+
+// Existing render modes: 0 = MIS, 1 = continuation sampling, 2 = NEE.
+// Callers validate nonnegative finite PDFs and the mode. These weights use
+// angular densities conditional on a reached scattering vertex. Free-flight
+// survival and roulette are represented by their sampling/throughput factors;
+// they must not be inserted a second time in an endpoint contribution.
+M1_HD inline float sun_emission_weight(int bounce, bool previous_delta,
+    unsigned direct_mode, float scattering_pdf, float sun_pdf) {
+    if (bounce == 0 || previous_delta || direct_mode == 1u) return 1.0f;
+    if (direct_mode == 2u) return 0.0f;
+    return m1::power_heuristic(scattering_pdf, sun_pdf);
+}
+
+M1_HD inline float nee_weight(unsigned direct_mode, float light_pdf, float scattering_pdf) {
+    if (direct_mode == 1u) return 0.0f;
+    if (direct_mode == 2u) return 1.0f;
+    return m1::power_heuristic(light_pdf, scattering_pdf);
+}
+
+M1_HD inline bool area_emission_needs_pdf(bool previous_medium, int bounce,
+    bool previous_delta, unsigned direct_mode) {
+    return !previous_medium && bounce > 0 && !previous_delta && direct_mode == 0u;
+}
+
+M1_HD inline float area_emission_weight(bool previous_medium, int bounce,
+    bool previous_delta, unsigned direct_mode, float scattering_pdf, float light_pdf) {
+    // M3 intentionally has no area-light NEE at a medium vertex. A phase path
+    // that reaches an emitter is therefore the sole strategy, even in mode 2.
+    if (previous_medium) return 1.0f;
+    return sun_emission_weight(bounce, previous_delta, direct_mode, scattering_pdf, light_pdf);
+}
+
+} // namespace m3
