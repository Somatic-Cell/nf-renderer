new file mode 100644
index 0000000..63f28dd
--- /dev/null
+++ b/shaders/device/m3_atmosphere.cuh
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "../params/per_ray_data.cuh"
+#include "shader_common.cuh"
+#include "m1_diagnostics.cuh"
+#include "../../include/m1/math.hpp"
+#include "../../include/m3/atmosphere.hpp"
+#include "../../include/m3/position.hpp"
+#include "../../include/m3/transport.hpp"
+
+// Thin OptiX adapter. The numerical atmosphere itself is the same host/device
+// implementation exercised by the CPU regression tests. All positions remain
+// in the renderer's metre-valued local coordinates; the large planet-centred
+// subtraction and optical-depth integration use double precision in the core.
+namespace m3device {
+
+static __forceinline__ __device__ m3::RaySegment ray(
+    m1::Vec3 origin,m1::Vec3 direction,float t_max) {
+    return {{double(origin.x),double(origin.y),double(origin.z)},
+            {double(direction.x),double(direction.y),double(direction.z)},double(t_max)};
+}
+
+static __forceinline__ __device__ m3::DVec3 point_at_distance(
+    const m3::RaySegment& r,double distance_m) {
+    // Keep the same metric parameterization and FMA evaluation as the
+    // numerical core. Do not narrow a valid point before checking its domain.
+    const auto direction=r.direction/m3::length(r.direction);
+    return {::fma(direction.x,distance_m,r.origin.x),
+            ::fma(direction.y,distance_m,r.origin.y),
+            ::fma(direction.z,distance_m,r.origin.z)};
+}
+
+static __forceinline__ __device__ void geometry_failure(
+    PRDSpectral& p,const m3::RaySegment& r,m3::Status status) {
+    m1diagnostics::fail(p,m1::FailureReason::AtmosphereGeometry,
+        {{float(status),float(r.t_max),float(r.origin.x),float(r.origin.y),float(r.origin.z),
+          float(r.direction.x),float(r.direction.y),float(r.direction.z)}});
+}
+
+static __forceinline__ __device__ bool coefficient(PRDSpectral& p,double& beta) {
+    if(m3::rayleigh_coefficient(optixLaunchParams.rayleigh,double(p.waveLength),beta))return true;
+    m1diagnostics::fail(p,m1::FailureReason::AtmosphereIntegral,
+        {{-1,0,0,0,0,0,p.waveLength}});
+    return false;
+}
+
+// t_max is the parameter of the raw float ray, not an assumed metric length.
+// This is used ONLY by explicit light connections. Sampled path continuation
+// already includes free-flight survival and must never multiply this T again.
+static __forceinline__ __device__ float connection_transmittance(PRDSpectral& p,
+    m1::Vec3 origin,m1::Vec3 direction,float t_max,bool include_attenuation=true) {
+    const auto& a=optixLaunchParams.rayleigh;
+    if(!a.enabled)return 1.0f;
+    const auto r=ray(origin,direction,t_max);
+    const auto segment=m3::clip_atmosphere(a,r);
+    if(segment.status!=m3::Status::Ok){geometry_failure(p,r,segment.status);return 0;}
+    // The planet remains an opaque geometric blocker even when the optional
+    // surface-to-area-light attenuation approximation is selected.
+    if(segment.ground_occludes)return 0;
+    if(!include_attenuation||!segment.has_medium)return 1.0f;
+    double beta=0;
+    if(!coefficient(p,beta))return 0;
+    const auto result=m3::transmittance(a,r,beta);
+    if(result.status!=m3::Status::Ok){
+        m1diagnostics::fail(p,m1::FailureReason::AtmosphereIntegral,
+            {{float(result.status),float(segment.begin_m),float(segment.end_m),float(result.tau),
+              float(result.estimated_error),float(result.evaluations),p.waveLength}});
+        return 0;
+    }
+    return result.ground_occluded?0.0f:float(result.transmittance);
+}
+
+} // namespace m3device
